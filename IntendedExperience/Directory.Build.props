<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Game version to build for: 1.44.1 (default), 1.40.8 or 1.29.1, e.g. `dotnet build -p:TargetGame=1.40.8`. -->
  <PropertyGroup>
    <TargetGame Condition="'$(TargetGame)' == ''">1.44.1</TargetGame>
  </PropertyGroup>

  <!-- Plugin Metadata -->
  <PropertyGroup>
    <PluginId>IntendedExperience</PluginId>
    <PluginName>IntendedExperience</PluginName>
    <Authors>Fatalution</Authors>
    <!-- Development builds add a letter as a prerelease tag (0.3.2-a, shown as 0.3.2a); releases drop it. -->
    <Version>0.4.0</Version>
    <GameVersion>$(TargetGame)</GameVersion>
    <Description>Shows GLS maps, Chroma maps and modcharts as the mapper made them by setting effects, colors, environment and brightness for that map only.</Description>
    <ProjectSource>https://github.com/Fatalution/BS_IntendedExperience</ProjectSource>
  </PropertyGroup>

  <!-- Plugin Dependencies -->
  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetGame)' == '1.44.1'">
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.14.1"/>
    <DependsOn Include="SiraUtil" Version="^3.3.1"/>
    <DependsOn Include="SongCore" Version="^3.16.0"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetGame)' == '1.40.8'">
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.12.5"/>
    <DependsOn Include="SiraUtil" Version="^3.2.1"/>
    <DependsOn Include="SongCore" Version="^3.15.3"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetGame)' == '1.29.1'">
    <DependsOn Include="BeatSaberMarkupLanguage" Version="^1.6.10"/>
    <DependsOn Include="SiraUtil" Version="^3.1.2"/>
    <DependsOn Include="SongCore" Version="^3.11.1"/>
  </ItemGroup>

  <!-- Per-version code differences and separate build folders, so the builds never mix. -->
  <PropertyGroup Condition="'$(TargetGame)' == '1.40.8'">
    <DefineConstants>$(DefineConstants);GAME_1_40</DefineConstants>
    <BaseOutputPath>bin\1.40.8\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\1.40.8\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetGame)' == '1.29.1'">
    <DefineConstants>$(DefineConstants);GAME_1_29</DefineConstants>
    <BaseOutputPath>bin\1.29.1\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\1.29.1\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DisableZipRelease>true</DisableZipRelease>
  </PropertyGroup>

</Project>
