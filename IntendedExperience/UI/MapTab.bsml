<vertical xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'
          spacing="2" pad="4" vertical-fit="PreferredSize">
    <toggle-setting text="Enabled" value="enabled" apply-on-change="true" bind-value="true"
                    hover-hint="Turns Intended Experience on or off."/>
    <!-- Fixed height, so the toggle above stays in place however long the text is. -->
    <vertical pref-height="34" vertical-fit="Unconstrained" child-align="UpperLeft"
              child-control-height="true" child-expand-height="false" child-control-width="true" child-expand-width="true">
        <text text="~status-text" font-size="4" word-wrapping="true" rich-text="true"/>
    </vertical>
</vertical>
