<!-- Mirrors Heck's SettableSettingsContent.bsml; parsed again for every map so the rows are laid out fresh. -->
<bg id='content-object' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <vertical anchor-max-y='1.05' bg='round-rect-panel' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
    <scroll-view preferred-height='50' preferred-width='120'>
      <macro.for-each hosts='rows'>
        <horizontal preferred-width='100'>
          <text text='~setting' align='Left' font-size='4'/>
          <text text='~change' align='Right' font-size='4'/>
        </horizontal>
      </macro.for-each>
    </scroll-view>
  </vertical>
</bg>
