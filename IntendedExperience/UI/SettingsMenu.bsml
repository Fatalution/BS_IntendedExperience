<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <toggle-setting text="Enabled" value="enabled" apply-on-change="true"
                    hover-hint="Turns Intended Experience on or off."/>

    <!-- Hidden while the mod is disabled. -->
    <vertical id="settings-body" vertical-fit="PreferredSize" horizontal-fit="Unconstrained"
              child-control-width="true" child-expand-width="true">
        <!-- Gap before each section. One set of toggles for the map type picked above them; the colors toggle
             is last because it's hidden for Chroma maps, which color their own lights. -->
        <horizontal pref-height="3"/>
        <horizontal pref-height="6">
            <text text="Map Types" font-size="4" color="#AAAAAA" word-wrapping="false"/>
        </horizontal>
        <horizontal pref-height="8" child-control-width="true" child-expand-width="true">
            <text-segments contents="categories" select-cell="select-category"/>
        </horizontal>
        <toggle-setting text="Enable All Effects" value="force-all-effects" bind-value="true" apply-on-change="true"
                        hover-hint="Sets environment effects to All Effects."/>
        <toggle-setting text="Use Map Environment" value="force-map-environment" bind-value="true" apply-on-change="true"
                        hover-hint="Turns off your environment override, so the map plays in the environment it was made for."/>
        <toggle-setting text="Set Effects Brightness to 100%" value="force-full-brightness" bind-value="true" apply-on-change="true"
                        interactable="~beat-saber-plus-available"
                        hover-hint="Reverts the BeatSaberPlus effects brightness override to 100%. Requires BeatSaberPlus GameTweaker."/>
        <toggle-setting id="colors-toggle" text="Use Intended Colors" value="force-intended-colors" bind-value="true" apply-on-change="true"
                        hover-hint="Sets color override to Notes Only and uses the correct color scheme for the environment, or the map's own SongCore color scheme if it has one."/>

        <horizontal pref-height="3"/>
        <toggle-setting text="Apply to replays" value="apply-to-replays" apply-on-change="true"
                        hover-hint="Applies IE's changes to BeatLeader and ScoreSaber replays too."/>
        <toggle-setting text="Apply in Multiplayer+" value="apply-in-multiplayer-plus" apply-on-change="true"
                        interactable="~multiplayer-plus-available"
                        hover-hint="In Multiplayer+ lobbies, applies the map's Settings Setter and IE's changes without asking. Requires BeatSaberPlus Multiplayer+."/>

        <horizontal pref-height="3"/>
        <horizontal pref-height="6">
            <text text="Menu" font-size="4" color="#AAAAAA" word-wrapping="false"/>
        </horizontal>
        <toggle-setting text="Tint Play button" value="tint-play-button" apply-on-change="true"
                        hover-hint="Turns the Play button orange when Intended Experience will change settings for the selected map."/>
        <toggle-setting text="Show tooltips" value="show-tooltips" apply-on-change="true"
                        hover-hint="Shows hover hints on the Play and IE buttons."/>
        <toggle-setting text="Show changes in Settings Setter" value="show-in-settings-setter" apply-on-change="true"
                        interactable="~settings-setter-available"
                        hover-hint="On maps without Settings Setter, shows IE's changes in a matching window after pressing Play. Requires Heck."/>

        <horizontal pref-height="3"/>
        <horizontal pref-height="8" spacing="2" child-control-width="true" child-expand-width="false">
            <horizontal pref-width="0" flexible-width="1" child-control-width="true" child-expand-width="true">
                <text text="~exclusions-text" font-size="4" color="#AAAAAA" align="Left" word-wrapping="false"/>
            </horizontal>
            <button text="Clear all" min-width="18" pref-width="18" pref-height="6" on-click="clear-exclusions"
                    hover-hint="Remove every map from the exclusion list."/>
        </horizontal>
        <vertical id="excluded-rows" spacing="1" vertical-fit="PreferredSize" horizontal-fit="Unconstrained"
                  child-control-width="true" child-expand-width="true"/>
    </vertical>

    <!-- Footer: three equal columns keep the credit centred with the version at the right edge. -->
    <horizontal pref-height="8" child-control-width="true" child-expand-width="false">
        <horizontal pref-width="0" flexible-width="1"/>
        <horizontal pref-width="0" flexible-width="1" child-control-width="true" child-expand-width="true">
            <text text="Made with &lt;3 by Fatalution" font-size="3.5" color="#808080" align="Center" word-wrapping="false"/>
        </horizontal>
        <horizontal pref-width="0" flexible-width="1" child-control-width="true" child-expand-width="true">
            <text text="~version-text" font-size="3.5" color="#808080" align="Right" word-wrapping="false"/>
        </horizontal>
    </horizontal>
</settings-container>
