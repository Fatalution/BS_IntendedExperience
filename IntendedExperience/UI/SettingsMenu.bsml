<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <toggle-setting text="Enabled" value="enabled" apply-on-change="true"
                    hover-hint="Apply a map's intended settings when you launch it. Your saved settings are never changed."/>

    <horizontal pref-height="6">
        <text text="Rules" font-size="4" color="#AAAAAA" word-wrapping="false"/>
    </horizontal>
    <toggle-setting text="Enable All Effects" value="force-all-effects" apply-on-change="true"
                    hover-hint="Turns all environment effects on if you have them reduced or off."/>
    <toggle-setting text="Use Intended Colors" value="force-intended-colors" apply-on-change="true"
                    hover-hint="Lights use the map's colors: an All color override becomes Notes Only, and the map's own effect colors are enabled. Note and wall colors are untouched."/>

    <horizontal pref-height="6">
        <text text="Menu" font-size="4" color="#AAAAAA" word-wrapping="false"/>
    </horizontal>
    <toggle-setting text="Tint Play button" value="tint-play-button" apply-on-change="true"
                    hover-hint="Turns the Play button orange when launching will apply intended settings."/>

    <horizontal pref-height="8">
        <text text="~exclusions-text" font-size="4" color="#AAAAAA" align="Left" word-wrapping="false"/>
        <button text="Clear all" on-click="clear-exclusions" hover-hint="Remove every map from the exclusion list."/>
    </horizontal>
    <custom-list id="excluded-list" contents="~excluded-maps" visible-cells="5" cell-size="7" list-width="90"
                 show-scrollbar="true" clickable-cells="false">
        <horizontal pref-width="90" pref-height="7" child-expand-width="false">
            <text text="~map-name" font-size="3.5" pref-width="74" overflow-mode="Ellipsis" word-wrapping="false" rich-text="true"/>
            <button text="Remove" pref-width="16" pref-height="6" on-click="remove"/>
        </horizontal>
    </custom-list>
</settings-container>
