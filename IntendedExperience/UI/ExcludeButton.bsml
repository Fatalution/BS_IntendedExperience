<button xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'
        id="exclude-button" text="~button-text" on-click="toggle-exclusion" pref-width="10" pref-height="10" rich-text="true"
        hover-hint="Click to disable IE for this map. This will be saved."/>
